pipeline{
    agent { label = "my-agent" }
    
    stages{
        stage("Code Clone"){
            steps{
                echo "Code Clone Stage"
                git url: "https://github.com/Pratik-s108/Tic-Tac-Toe.git", branch: "newjs_script"
            }
        }
        stage("package-installation-sh"){
            steps{
                echo 'Running shell-script for installing package'
                sh "bash package-installation.sh"
            }
        }
        stage("Code Build"){
            steps{
                echo "Code Build Stage"
                sh "docker build -t pratiklanjewar4198040/game-img ."
            }
        }
        stage("Push To DockerHub"){
            steps{
                withCredentials([usernamePassword(
                    credentialsId:"DockerHub_ID",
                    usernameVariable:"dockerHubUser", 
                    passwordVariable:"dockerHubPass")]){
                sh 'echo $dockerHubPass | docker login -u $dockerHubUser --password-stdin'
                sh "docker push pratiklanjewar4198040/game-img:latest"
                }
            }
        }
	stage("Infrastructure"){
	    steps{
		sh '''cd terraform/
			terraform init
			terraform plan
			terraform apply --auto-approve
		''' //terraform destroy --auto-approve
	    }
	}
        stage("Deploy"){
            steps{
                sh '''aws eks update-kubeconfig --name My-cluster --region ap-south-1
			kubectl apply -f k8s/'''
            }
        }
    }
}
